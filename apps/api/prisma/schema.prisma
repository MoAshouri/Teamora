generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveKind {
  DAILY
  HOURLY
}

enum LeaveGrantSource {
  REQUEST
  BONUS
}

enum CalendarType {
  JALALI
  GREGORIAN
}

enum ReminderStatus {
  ACTIVE
  SNOOZED
  ACKED
  DISABLED
}

enum ReminderTargetKind {
  TASK
  NOTE
  MEETING
  CUSTOM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String?
  fullName     String
  role         Role
  googleId     String?  @unique
  avatarUrl    String?
  emailVerifiedAt         DateTime?
  pendingEmail            String?
  pendingEmailRequestedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCompany     Company?            @relation("CompanyAdmin")
  membership       CompanyMembership?
  timeEntries      TimeEntry[]
  activeSession    ActiveWorkSession?
  leaveRequests    LeaveRequest[]
  createdEvents    CalendarEvent[]     @relation("EventCreator")
  eventAttendances CalendarAttendee[]
  reviewedLeaves   LeaveRequest[]      @relation("LeaveReviewer")
  reviewedEntries  TimeEntry[]         @relation("TimeEntryReviewer")
  createdInvites            InviteCode[]
  leaveBalanceAdjustments   LeaveBalanceAdjustment[]
  grantedLeaveAdjustments   LeaveBalanceAdjustment[] @relation("LeaveGrantActor")
  lettersAuthored           Letter[]               @relation("LetterAuthor")
  lettersReceived           Letter[]              @relation("LetterRecipient")
  tasksCreated              Task[]               @relation("TaskCreator")
  tasksAssigned             Task[]               @relation("TaskAssignee")
  notesCreated              Note[]                @relation("NoteCreator")
  remindersCreated          Reminder[]           @relation("ReminderCreator")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  adminId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin        User                 @relation("CompanyAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  memberships  CompanyMembership[]
  inviteCodes  InviteCode[]
  workPolicy   WorkPolicy?
  timeEntries  TimeEntry[]
  activeSessions ActiveWorkSession[]
  leaveRequests LeaveRequest[]
  events       CalendarEvent[]
  leaveBalanceAdjustments LeaveBalanceAdjustment[]
  letters      Letter[]
  tasks        Task[]
  notes        Note[]
  reminders    Reminder[]
}

model CompanyMembership {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique
  joinedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model InviteCode {
  id        String    @id @default(cuid())
  companyId String
  code      String    @unique
  createdBy String
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WorkPolicy {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  workStart             String
  workEnd               String
  workDays              Int[]
  timezone              String   @default("Asia/Tehran")
  dailyMinutes          Int      @default(480)
  overtimeAfterMinutes  Int      @default(480)
  flexInMinutes         Int      @default(0)
  flexOutMinutes        Int      @default(0)
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id         String          @id @default(cuid())
  companyId  String
  userId     String
  date       DateTime        @db.Date
  startedAt  DateTime
  endedAt    DateTime
  note       String?
  status     TimeEntryStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("TimeEntryReviewer", fields: [reviewedBy], references: [id])

  @@index([companyId, date])
  @@index([userId, date])
}

model ActiveWorkSession {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LeaveRequest {
  id         String           @id @default(cuid())
  companyId  String
  userId     String
  type       LeaveType
  kind       LeaveKind        @default(DAILY)
  hours      Decimal?         @db.Decimal(6, 2)
  source     LeaveGrantSource @default(REQUEST)
  startDate  DateTime         @db.Date
  endDate    DateTime         @db.Date
  reason     String?
  status     LeaveStatus      @default(PENDING)
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("LeaveReviewer", fields: [reviewedBy], references: [id])

  @@index([companyId, status])
  @@index([userId])
}

model LeaveBalanceAdjustment {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  kind      LeaveKind
  amount    Decimal   @db.Decimal(8, 2)
  note      String?
  createdBy String
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor   User    @relation("LeaveGrantActor", fields: [createdBy], references: [id])

  @@index([companyId, userId])
}

model Letter {
  id          String    @id @default(cuid())
  companyId   String
  authorId    String
  recipientId String
  subject     String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User    @relation("LetterAuthor", fields: [authorId], references: [id])
  recipient User    @relation("LetterRecipient", fields: [recipientId], references: [id])

  @@index([companyId, recipientId])
  @@index([recipientId, readAt])
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  creatorId   String
  assigneeId  String?
  title       String
  description String?
  dueAt       DateTime?
  starred     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([companyId, dueAt])
  @@index([companyId, starred])
  @@index([assigneeId])
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  creatorId String
  title     String
  body      String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User    @relation("NoteCreator", fields: [creatorId], references: [id])

  @@index([companyId, date])
}

model Reminder {
  id          String             @id @default(cuid())
  companyId   String
  creatorId   String
  targetKind  ReminderTargetKind
  targetId    String?
  title       String
  fireAt      DateTime
  status      ReminderStatus     @default(ACTIVE)
  snoozeUntil DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User    @relation("ReminderCreator", fields: [creatorId], references: [id])

  @@index([companyId, fireAt, status])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  companyId   String
  creatorId   String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator   User               @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  attendees CalendarAttendee[]

  @@index([companyId, startsAt])
}

model CalendarAttendee {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Holiday {
  id           String       @id @default(cuid())
  name         String
  nameFa       String?
  nameHy       String?
  date         DateTime     @db.Date
  calendarType CalendarType
  countryCode  String
  recurring    Boolean      @default(true)

  @@index([calendarType, countryCode])
  @@index([date])
}
