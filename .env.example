# Database
DATABASE_URL=postgresql://teamora:teamora@localhost:5432/teamora?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Email OTP (SMTP) — prefer 587 + SMTP_SECURE=false (STARTTLS). Port 465 often blocked.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teamora.app

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
